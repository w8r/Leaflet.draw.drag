{
  "name": "leaflet-draw-drag",
  "type": "module",
  "version": "1.0.0",
  "description": "Drag feature functionality for Leaflet.draw",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "browser": "dist/index.js",
  "unpkg": "dist/index.js",
  "jsdelivr": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src/**/*.mjs"
  ],
  "scripts": {
    "start": "vite",
    "lint": "eslint ./src --ext .mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:types": "node scripts/build-types.mjs",
    "build": "npm run lint && vite build && npm run build:types",
    "docs": "vite build -c example/vite.config.ts",
    "release": "git push origin master && git checkout gh-pages && git merge master && git push origin gh-pages && git checkout master && npm publish"
  },
  "keywords": [
    "leaflet",
    "draw",
    "drag",
    "polygon"
  ],
  "author": "Alexander Milevski <info@w8r.name>",
  "repository": {
    "type": "git",
    "url": "git://github.com/w8r/Leaflet.draw.drag.git"
  },
  "bugs": {
    "url": "https://github.com/w8r/Leaflet.draw.drag/issues"
  },
  "license": "MIT",
  "prettier": {
    "singleQuote": true
  },
  "peerDependencies": {
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4"
  },
  "dependencies": {
    "leaflet-path-drag": "^1.9.5"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jsdom": "^24.0.0",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "vite": "^5.1.3",
    "vitest": "^1.4.0"
  }
}
